MYSQL_ROOT_PASSWORD=carizon_pass
MYSQL_DATABASE=carizon
MYSQL_USER=carizon
MYSQL_PASSWORD=carizon
MYSQL_HOST=mysql

APP_PORT=8080

# Frontend(GA) - 배포 시 compose build 시점에 주입됩니다.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

OLLAMA_LLM_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# MySQL init bootstrap options
MYSQL_BOOTSTRAP_SCHEMA=true
MYSQL_BOOTSTRAP_MIGRATIONS=true
MYSQL_BOOTSTRAP_SCHEMA_SQL=/docker-init/schema_from_excel.sql
MYSQL_BOOTSTRAP_MIGRATION_DIR=/docker-migrations

# 로컬 MySQL 덤프를 가져오려면 경로를 지정 (예: /docker-init/local_dump.sql)
# MYSQL_IMPORT_DUMP_FILE=/docker-init/local_dump.sql
